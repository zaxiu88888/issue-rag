# Copy to .env and fill in what you use. .env is gitignored.
#
# The evaluation pipeline needs ONE inference entry point. Either an API key
# here, or local weights under data/models (see `python -m issue_rag.models`).

# --- generator / judge -------------------------------------------------------
# Recommended on slow networks: no 6 GB download.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=

# --- GitHub ----------------------------------------------------------------
# Anonymous access is 60 requests/hour, which makes the per-issue comment
# harvest take hours instead of minutes. A fine-grained token with
# public-repository read-only access is enough; no scopes beyond that.
GITHUB_TOKEN=
